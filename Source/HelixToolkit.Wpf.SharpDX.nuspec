<?xml version="1.0"?>
<package xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <metadata xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
    <id>HelixToolkit.Wpf.SharpDX</id>
    <version>$version$</version>
    <title>HelixToolkit for WPF DirectX</title>
    <authors>Lunci</authors>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/helix-toolkit/helix-toolkit</projectUrl>
    <icon>helixtoolkit.png</icon>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Provides custom controls for WPF and a DirectX scene graph based on Silk.NET.</description>
    <readme>README.md</readme>
    <tags>wpf Silk.NET DirectX 3D</tags>
    <dependencies>
	    <group targetFramework="net10.0-windows">
		    <dependency id="HelixToolkit" version="[$version$]" />
		    <dependency id="Cyotek.Drawing.BitmapFont" version="2.0.0" />
		    <dependency id="Silk.NET.Direct2D" version="2.23.0" />
		    <dependency id="Silk.NET.Direct3D.Compilers" version="2.23.0" />
		    <dependency id="Silk.NET.Direct3D11" version="2.23.0" />
		    <dependency id="Silk.NET.Direct3D9" version="2.23.0" />
		    <dependency id="Silk.NET.DXGI" version="2.23.0" />
		    <dependency id="Silk.NET.Maths" version="2.23.0" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="HelixToolkit.Wpf.SharpDX\bin\Release\net10.0-windows\HelixToolkit.Wpf.SharpDX.???" target="lib\net10.0-windows" />
    <file src="..\LICENSE" />
    <file src="..\AUTHORS" />
    <file src="..\CONTRIBUTORS" />
    <file src="..\README.md" />
	<file src="..\Images\helixtoolkit.png" target="" />
  </files>
</package>

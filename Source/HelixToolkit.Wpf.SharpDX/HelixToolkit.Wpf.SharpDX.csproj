<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>

        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>

        <SignAssembly>false</SignAssembly>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <Version>0.0.0.1</Version>
        <Authors>HelixToolkit Contributors</Authors>
        <Company>HelixToolkit</Company>

        <!-- Legacy ResX behavior: skip missing files generated by ShaderBuilder -->
        <GenerateResourceForMissReferences>true</GenerateResourceForMissReferences>
        <UseSRI>false</UseSRI>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Debug'">
        <DefineConstants>TRACE;DEBUG;DX11;MSAA;SILKNET;</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Release'">
        <DefineConstants>TRACE;DX11;MSAA;SILKNET;</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\HelixToolkit\HelixToolkit.csproj" />
        <ProjectReference Include="..\HelixToolkit.SharpDX.Core\HelixToolkit.SharpDX.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Silk.NET.Direct2D" Version="2.23.0" />
        <PackageReference Include="Silk.NET.Direct3D9" Version="2.23.0" />
        <PackageReference Include="Silk.NET.Maths" Version="2.23.0" />
    </ItemGroup>

    <Import Project="..\HelixToolkit.SharpDX.Shared\HelixToolkit.SharpDX.Shared.projitems" Label="Shared" />
    <Import Project="..\HelixToolkit.Shared\HelixToolkit.Shared.projitems" Label="Shared" />
    <Import Project="..\HelixToolkit.SharpDX.SharedModel\HelixToolkit.SharpDX.SharedModel.projitems" Label="Shared" />
    <Import Project="..\HelixToolkit.Wpf.SharpDX.Shared\HelixToolkit.Wpf.SharpDX.Shared.projitems" Label="Shared" />

</Project>

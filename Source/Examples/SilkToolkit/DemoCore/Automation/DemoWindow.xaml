<Window x:Class="DemoCore.Automation.DemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:controls="clr-namespace:HelixToolkit.Wpf.SharpDX.Controls;assembly=SilkToolkit"
        xmlns:lights3D="clr-namespace:HelixToolkit.Wpf.SharpDX.Model.Lights3D;assembly=SilkToolkit"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="{Binding Title}" Height="600" Width="800"
        mc:Ignorable="d">
    <Grid>
        <controls:Viewport3DX x:Name="View"
                        Camera="{Binding Camera}"
                        EffectsManager="{Binding EffectsManager}">
            <lights3D:AmbientLight3D />
            <lights3D:DirectionalLight3D Direction="-2,-5,-2" />
        </controls:Viewport3DX>
    </Grid>
</Window>

<Window
    x:Class="D2DScreenMenuExample.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
    xmlns:local="clr-namespace:D2DScreenMenuExample"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:HelixToolkit.Wpf.SharpDX.Controls;assembly=SilkToolkit"
    xmlns:lights3D="clr-namespace:HelixToolkit.Wpf.SharpDX.Model.Lights3D;assembly=SilkToolkit"
    xmlns:element3D="clr-namespace:HelixToolkit.Wpf.SharpDX.Element3D;assembly=SilkToolkit"
    xmlns:elements2D="clr-namespace:HelixToolkit.Wpf.SharpDX.Model.Elements2D;assembly=SilkToolkit"
    Title="MainWindow"
    Width="600"
    Height="600"
    Background="Black"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" Background="AntiqueWhite">
            <CheckBox IsChecked="{Binding ElementName=View1, Path=EnableDpiScale}" HorizontalAlignment="Left"
                      VerticalAlignment="Center">
                High Dpi
            </CheckBox>
            <Label Margin="25,0,0,0">Test Binding:</Label>
            <TextBox x:Name="Tb" Width="200" VerticalContentAlignment="Center">Btn 3</TextBox>
        </StackPanel>
        <controls:Viewport3DX Name="View1"
                        Grid.Row="1"
                        Camera="{Binding Camera}"
                        EffectsManager="{Binding EffectsManager}"
                        EnableSwapChainRendering="True"
                        EnableDesignModeRendering="False">
            <lights3D:DirectionalLight3D Direction="{Binding Vm3D.Light1Direction}" Color="{Binding Vm3D.Light1Color}" />
            <lights3D:DirectionalLight3D Direction="{Binding Vm3D.Light2Direction}" Color="{Binding Vm3D.Light2Color}" />
            <lights3D:DirectionalLight3D Direction="{Binding Vm3D.Light3Direction}" Color="{Binding Vm3D.Light3Color}" />
            <element3D:MeshGeometryModel3D
                CullMode="Back"
                Geometry="{Binding Vm3D.Model}"
                Material="{Binding Vm3D.ModelMaterial}" />
            <controls:Viewport3DX.Content2D>
                <elements2D:Panel2D>
                    <elements2D:StackPanel2D Orientation="Vertical">
                        <elements2D:StackPanel2D
                            Margin="10,20"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                            <elements2D:TextModel2D
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{Binding Vm2D.Text}" />
                            <elements2D:TextModel2D
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Text="{Binding Vm2D.Text}" />
                            <elements2D:TextModel2D
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{Binding Vm2D.Text}" />
                            <elements2D:TextModel2D
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Text="{Binding Vm2D.Text}" />
                            <elements2D:Button2D Margin="10" VerticalAlignment="Center">Button 1</elements2D:Button2D>
                            <elements2D:Button2D Margin="10" VerticalAlignment="Center">Button 2</elements2D:Button2D>
                        </elements2D:StackPanel2D>
                        <elements2D:StackPanel2D
                            Margin="10"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Orientation="Vertical">
                            <elements2D:StackPanel2D VerticalAlignment="Center" Orientation="Horizontal">
                                <elements2D:Button2D Margin="10" VerticalAlignment="Center" Width="60" Height="30"
                                               Content2D="{Binding ElementName=Tb, Path=Text}">
                                </elements2D:Button2D>
                                <elements2D:Button2D Margin="10" VerticalAlignment="Center" Width="60" Height="30">Button 4</elements2D:Button2D>
                            </elements2D:StackPanel2D>
                            <elements2D:Button2D Margin="10" HorizontalAlignment="Center">Button4</elements2D:Button2D>
                            <elements2D:Button2D Margin="10" HorizontalAlignment="Center">Button5</elements2D:Button2D>
                            <elements2D:EllipseModel2D
                                Width="20"
                                Height="20"
                                Fill="AliceBlue"
                                Stroke="Red"
                                StrokeThickness="1" />
                        </elements2D:StackPanel2D>
                    </elements2D:StackPanel2D>


                    <elements2D:EllipseModel2D
                        Width="50"
                        Height="20"
                        Fill="Green"
                        Stroke="Red"
                        StrokeThickness="2" />
                    <elements2D:ImageModel2D VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Width="100" Height="100"
                                       ImageStream="{Binding Vm2D.ImageStream}" />
                </elements2D:Panel2D>
            </controls:Viewport3DX.Content2D>
        </controls:Viewport3DX>
    </Grid>
</Window>
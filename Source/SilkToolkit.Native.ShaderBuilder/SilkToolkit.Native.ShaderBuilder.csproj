  <Target Name="CopyDxcShadersToSilkCoreResources"
          AfterTargets="Build"
          Condition="'@(DxcShader)' != ''">
    <ItemGroup>
      <_DxcManifestLine Include="%(DxcShader.Identity)|%(DxcShader.EntryPointName)|%(DxcShader.ShaderProfile)|%(DxcShader.RelativeDir)%(DxcShader.ShaderName).%(DxcShader.EntryPointName).dxil"/>
    </ItemGroup>
    <RemoveDir Directories="$(ProjectDir)..\SilkCore\Resources\DX12"/>
    <Copy SourceFiles="@(DxcShader->'%(ObjectFileOutput)')"
          DestinationFiles="@(DxcShader->'$(ProjectDir)..\SilkCore\Resources\DX12\%(RelativeDir)%(ShaderName).%(EntryPointName).dxil')"
          SkipUnchangedFiles="true"/>
    <WriteLinesToFile File="$(ProjectDir)..\SilkCore\Resources\DX12\shader-manifest.txt"
                      Lines="@(_DxcManifestLine)"
                      Overwrite="true"
                      Encoding="UTF-8"/>
  </Target>


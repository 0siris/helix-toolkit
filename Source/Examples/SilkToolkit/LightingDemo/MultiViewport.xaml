<Window
    x:Class="LightingDemo.MultiViewport"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
    xmlns:local="clr-namespace:LightingDemo"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:HelixToolkit.Wpf.SharpDX.Controls;assembly=SilkToolkit"
    xmlns:light3D="clr-namespace:HelixToolkit.Wpf.SharpDX.Light3D;assembly=SilkToolkit"
    xmlns:element3D="clr-namespace:HelixToolkit.Wpf.SharpDX.Element3D;assembly=SilkToolkit"
    xmlns:lights3D="clr-namespace:HelixToolkit.Wpf.SharpDX.Model.Lights3D;assembly=SilkToolkit"
    Title="MultiViewport"
    Width="600"
    Height="600"
    mc:Ignorable="d">
    <Window.Resources>
        <controls:RenderTechniqueConverter x:Key="RenderTechniqueConverter" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <controls:ModelContainer3DX x:Name="SharedContainer" EffectsManager="{Binding EffectsManager}">
            <light3D:ShadowMap3D />


            <!--<hx:EnvironmentMap x:Name="envMap" Filename="Cubemap_Grandcanyon.dds"/>-->
            <element3D:MeshGeometryModel3D
                Geometry="{Binding Sphere}"
                IsRendering="{Binding RenderLight1}"
                Material="{Binding LightModelMaterial}"
                Transform="{Binding Light1Transform}" />
            <element3D:MeshGeometryModel3D
                Geometry="{Binding Sphere}"
                IsRendering="{Binding RenderLight2}"
                Material="{Binding LightModelMaterial}"
                Transform="{Binding Light2Transform}" />
            <element3D:MeshGeometryModel3D
                Geometry="{Binding Sphere}"
                IsRendering="{Binding RenderLight3}"
                Material="{Binding LightModelMaterial}"
                Transform="{Binding Light3Transform}" />
            <element3D:MeshGeometryModel3D
                Geometry="{Binding Sphere}"
                IsRendering="{Binding RenderLight4}"
                Material="{Binding LightModelMaterial}"
                Transform="{Binding Light4Transform}" />
            <element3D:MeshGeometryModel3D
                x:Name="Model"
                Geometry="{Binding Model}"
                Material="{Binding ModelMaterial}"
                Transform="{Binding ModelTransform}" />
            <element3D:MeshGeometryModel3D
                x:Name="Floor"
                Geometry="{Binding Floor}"
                Material="{Binding FloorMaterial}"
                Transform="{Binding FloorTransform}" />
        </controls:ModelContainer3DX>
        <controls:Viewport3DX
            x:Name="View1"
            Title="{Binding Title}"
            Grid.Row="0"
            Grid.Column="0"
            Camera="{Binding Camera}"
            CoordinateSystemLabelForeground="White"
            EnableSharedModelMode="True"
            IsShadowMappingEnabled="True"
            Msaa="Four"
            SharedModelContainer="{Binding ElementName=SharedContainer}"
            ShowCoordinateSystem="False"
            SubTitle="{Binding SubTitle}"
            TextBrush="Black"
            UseDefaultGestures="False">
            <controls:Viewport3DX.InputBindings>
                <KeyBinding Key="B" Command="controls:ViewportCommands.BackView" />
                <KeyBinding Key="F" Command="controls:ViewportCommands.FrontView" />
                <KeyBinding Key="U" Command="controls:ViewportCommands.TopView" />
                <KeyBinding Key="D" Command="controls:ViewportCommands.BottomView" />
                <KeyBinding Key="L" Command="controls:ViewportCommands.LeftView" />
                <KeyBinding Key="R" Command="controls:ViewportCommands.RightView" />
                <KeyBinding Command="controls:ViewportCommands.ZoomExtents" Gesture="Control+E" />
                <MouseBinding Command="controls:ViewportCommands.Rotate" Gesture="RightClick" />
                <MouseBinding Command="controls:ViewportCommands.Zoom" Gesture="MiddleClick" />
                <MouseBinding Command="controls:ViewportCommands.Pan" Gesture="LeftClick" />
            </controls:Viewport3DX.InputBindings>
            <lights3D:DirectionalLight3D
                Direction="{Binding Light1Direction}"
                IsRendering="{Binding RenderLight1}"
                Color="{Binding Light1Color}" />
            <lights3D:SpotLight3D
                Attenuation="{Binding Light4Attenuation}"
                Direction="{Binding Light4Direction}"
                IsRendering="{Binding RenderLight4}"
                Transform="{Binding Light4Transform}"
                Color="{Binding Light4Color}" />
        </controls:Viewport3DX>
        <controls:Viewport3DX
            x:Name="View2"
            Title="{Binding Title}"
            Grid.Row="0"
            Grid.Column="1"
            Camera="{Binding Camera2}"
            CoordinateSystemLabelForeground="White"
            EnableSharedModelMode="True"
            IsShadowMappingEnabled="True"
            Msaa="Four"
            SharedModelContainer="{Binding ElementName=SharedContainer}"
            ShowCoordinateSystem="False"
            SubTitle="{Binding SubTitle}"
            TextBrush="Black"
            UseDefaultGestures="False">
            <controls:Viewport3DX.InputBindings>
                <KeyBinding Key="B" Command="controls:ViewportCommands.BackView" />
                <KeyBinding Key="F" Command="controls:ViewportCommands.FrontView" />
                <KeyBinding Key="U" Command="controls:ViewportCommands.TopView" />
                <KeyBinding Key="D" Command="controls:ViewportCommands.BottomView" />
                <KeyBinding Key="L" Command="controls:ViewportCommands.LeftView" />
                <KeyBinding Key="R" Command="controls:ViewportCommands.RightView" />
                <KeyBinding Command="controls:ViewportCommands.ZoomExtents" Gesture="Control+E" />
                <MouseBinding Command="controls:ViewportCommands.Rotate" Gesture="RightClick" />
                <MouseBinding Command="controls:ViewportCommands.Zoom" Gesture="MiddleClick" />
                <MouseBinding Command="controls:ViewportCommands.Pan" Gesture="LeftClick" />
            </controls:Viewport3DX.InputBindings>
            <lights3D:DirectionalLight3D
                Direction="{Binding Light1Direction}"
                IsRendering="{Binding RenderLight1}"
                Color="{Binding Light1Color}" />
        </controls:Viewport3DX>
        <controls:Viewport3DX
            x:Name="View3"
            Title="{Binding Title}"
            Grid.Row="1"
            Grid.Column="0"
            Camera="{Binding Camera3}"
            CoordinateSystemLabelForeground="White"
            EnableSharedModelMode="True"
            IsShadowMappingEnabled="True"
            Msaa="Four"
            SharedModelContainer="{Binding ElementName=SharedContainer}"
            ShowCoordinateSystem="False"
            SubTitle="{Binding SubTitle}"
            TextBrush="Black"
            UseDefaultGestures="False">
            <controls:Viewport3DX.InputBindings>
                <KeyBinding Key="B" Command="controls:ViewportCommands.BackView" />
                <KeyBinding Key="F" Command="controls:ViewportCommands.FrontView" />
                <KeyBinding Key="U" Command="controls:ViewportCommands.TopView" />
                <KeyBinding Key="D" Command="controls:ViewportCommands.BottomView" />
                <KeyBinding Key="L" Command="controls:ViewportCommands.LeftView" />
                <KeyBinding Key="R" Command="controls:ViewportCommands.RightView" />
                <KeyBinding Command="controls:ViewportCommands.ZoomExtents" Gesture="Control+E" />
                <MouseBinding Command="controls:ViewportCommands.Rotate" Gesture="RightClick" />
                <MouseBinding Command="controls:ViewportCommands.Zoom" Gesture="MiddleClick" />
                <MouseBinding Command="controls:ViewportCommands.Pan" Gesture="LeftClick" />
            </controls:Viewport3DX.InputBindings>
            <lights3D:PointLight3D
                Attenuation="{Binding Light2Attenuation}"
                IsRendering="{Binding RenderLight2}"
                Transform="{Binding Light2Transform}"
                Color="{Binding Light2Color}" />
            <lights3D:PointLight3D
                Attenuation="{Binding Light3Attenuation}"
                IsRendering="{Binding RenderLight3}"
                Transform="{Binding Light3Transform}"
                Color="{Binding Light3Color}" />
        </controls:Viewport3DX>
        <controls:Viewport3DX
            x:Name="View4"
            Title="{Binding Title}"
            Grid.Row="1"
            Grid.Column="1"
            Camera="{Binding Camera4}"
            CoordinateSystemLabelForeground="White"
            EnableSharedModelMode="True"
            IsShadowMappingEnabled="True"
            Msaa="Four"
            SharedModelContainer="{Binding ElementName=SharedContainer}"
            ShowCoordinateSystem="False"
            SubTitle="{Binding SubTitle}"
            TextBrush="Black"
            UseDefaultGestures="False">
            <controls:Viewport3DX.InputBindings>
                <KeyBinding Key="B" Command="controls:ViewportCommands.BackView" />
                <KeyBinding Key="F" Command="controls:ViewportCommands.FrontView" />
                <KeyBinding Key="U" Command="controls:ViewportCommands.TopView" />
                <KeyBinding Key="D" Command="controls:ViewportCommands.BottomView" />
                <KeyBinding Key="L" Command="controls:ViewportCommands.LeftView" />
                <KeyBinding Key="R" Command="controls:ViewportCommands.RightView" />
                <KeyBinding Command="controls:ViewportCommands.ZoomExtents" Gesture="Control+E" />
                <MouseBinding Command="controls:ViewportCommands.Rotate" Gesture="RightClick" />
                <MouseBinding Command="controls:ViewportCommands.Zoom" Gesture="MiddleClick" />
                <MouseBinding Command="controls:ViewportCommands.Pan" Gesture="LeftClick" />
            </controls:Viewport3DX.InputBindings>
            <lights3D:SpotLight3D
                Attenuation="{Binding Light4Attenuation}"
                Direction="{Binding Light4Direction}"
                IsRendering="{Binding RenderLight4}"
                Transform="{Binding Light4Transform}"
                Color="{Binding Light4Color}" />
        </controls:Viewport3DX>
    </Grid>
</Window>
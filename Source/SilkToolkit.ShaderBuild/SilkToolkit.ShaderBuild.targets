<Project>
  <PropertyGroup>
    <DxcPackageRoot Condition="'$(DxcPackageRoot)' == ''">$(PkgMicrosoft_Direct3D_DXC)</DxcPackageRoot>
    <DxcToolPath Condition="'$(DxcToolPath)' == '' and '$(DxcPackageRoot)' != '' and Exists('$(DxcPackageRoot)\build\native\bin\x64\dxc.exe')">$(DxcPackageRoot)\build\native\bin\x64\dxc.exe</DxcToolPath>
    <DxcDebugArgs Condition="'$(DxcDebugArgs)' == '' and '$(Configuration)' == 'Debug'">-Zi -Qembed_debug</DxcDebugArgs>
    <DxcDebugArgs Condition="'$(DxcDebugArgs)' == ''">-O3</DxcDebugArgs>
  </PropertyGroup>

  <Target Name="PrepareDxcShaders"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <!-- Conservatively track all local includes, including PS helpers and nested HLSLI files. -->
      <DxcAdditionalInput Include="$(MSBuildProjectDirectory)\**\*.hlsl;$(MSBuildProjectDirectory)\**\*.hlsli;$(MSBuildProjectFullPath);$(MSBuildAllProjects);$(MSBuildThisFileFullPath);$(DxcToolPath)"/>
      <DxcAdditionalInput Include="$([System.IO.Path]::GetDirectoryName('$(DxcToolPath)'))\dxcompiler.dll;$([System.IO.Path]::GetDirectoryName('$(DxcToolPath)'))\dxil.dll"
                          Condition="'$(DxcToolPath)' != ''"/>
    </ItemGroup>

    <ItemGroup>
      <DxcShader>
        <EntryPointName Condition="'%(DxcShader.EntryPointName)' == ''">main</EntryPointName>
        <ShaderName Condition="'%(DxcShader.ShaderName)' == ''">%(DxcShader.Filename)</ShaderName>
      </DxcShader>
    </ItemGroup>

    <ItemGroup>
      <DxcShader>
        <ObjectFileOutput Condition="'%(DxcShader.ObjectFileOutput)' == ''">$(TargetDir)DX12\%(DxcShader.RelativeDir)%(DxcShader.ShaderName).%(DxcShader.EntryPointName).dxil</ObjectFileOutput>
      </DxcShader>
    </ItemGroup>

    <!-- Persist evaluated options and item metadata so command-line changes also invalidate outputs.
         WriteOnlyWhenDifferent keeps unchanged builds incremental; the input list detects added/removed includes. -->
    <PropertyGroup>
      <_DxcInputsFile>$(IntermediateOutputPath)$(MSBuildProjectFile).dxc.inputs</_DxcInputsFile>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" Condition="'$(IntermediateOutputPath)' != ''"/>
    <WriteLinesToFile File="$(_DxcInputsFile)"
                      Lines="$(DxcToolPath);$(DxcDebugArgs);@(DxcAdditionalInput);@(DxcShader->'%(FullPath)|%(EntryPointName)|%(ShaderProfile)|%(ObjectFileOutput)')"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"/>
  </Target>

  <Target Name="CompileDxcShaders"
          DependsOnTargets="PrepareDxcShaders;RunDxcShaders"
          BeforeTargets="CoreCompile"
          Condition="'$(DesignTimeBuild)' != 'true'"/>

  <Target Name="RunDxcShaders"
          Inputs="@(DxcShader);@(DxcAdditionalInput);$(_DxcInputsFile)"
          Outputs="%(DxcShader.ObjectFileOutput)"
          Condition="'@(DxcShader)' != '' and '$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(DxcToolPath)' == ''"
           Text="Microsoft.Direct3D.DXC package path was not found. Add PackageReference Microsoft.Direct3D.DXC with GeneratePathProperty=true."/>
    <Error Condition="'%(DxcShader.ShaderProfile)' == ''"
           Text="DxcShader item '%(DxcShader.Identity)' requires ShaderProfile metadata."/>
    <Error Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(DxcShader.ShaderProfile)', '^(vs|ps|gs|cs|hs|ds)_6_0$')) != 'true'"
           Text="DxcShader item '%(DxcShader.Identity)' requires an explicit supported SM6.0 profile."/>

    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('%(DxcShader.ObjectFileOutput)'))"/>

    <Message Importance="High"
             Text="DXC %(DxcShader.Identity) -> %(DxcShader.ObjectFileOutput)"/>
    <Exec Command="&quot;$(DxcToolPath)&quot; -nologo -E &quot;%(DxcShader.EntryPointName)&quot; -T &quot;%(DxcShader.ShaderProfile)&quot; -HV 2021 -I &quot;$(MSBuildProjectDirectory)&quot; -Fo &quot;%(DxcShader.ObjectFileOutput)&quot; $(DxcDebugArgs) &quot;%(DxcShader.FullPath)&quot;"/>
  </Target>
</Project>

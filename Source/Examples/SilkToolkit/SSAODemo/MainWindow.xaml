<Window
    x:Class="SSAODemo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
    xmlns:local="clr-namespace:SSAODemo"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:HelixToolkit.Wpf.SharpDX.Controls;assembly=SilkToolkit"
    xmlns:lights3D="clr-namespace:HelixToolkit.Wpf.SharpDX.Model.Lights3D;assembly=SilkToolkit"
    xmlns:element3D="clr-namespace:HelixToolkit.Wpf.SharpDX.Element3D;assembly=SilkToolkit"
    Title="MainWindow"
    Width="1000"
    Height="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <controls:Viewport3DX
            x:Name="Viewport"
            Grid.Column="0"
            Camera="{Binding Camera}"
            EffectsManager="{Binding EffectsManager}"
            EnableSsao="True"
            FxaaLevel="Medium"
            ShowFrameDetails="True">
            <lights3D:DirectionalLight3D Direction="-1, -1, 0" Color="#9A9A9A" />
            <lights3D:AmbientLight3D Color="#B0B0B0" />
            <element3D:MeshGeometryModel3D
                CullMode="Back"
                Geometry="{Binding FloorModel}"
                Material="{Binding FloorMaterial}" />
            <element3D:MeshGeometryModel3D
                CullMode="Back"
                Geometry="{Binding SphereModel}"
                Instances="{Binding SphereInstances}"
                Material="{Binding SphereMaterial}" />
            <element3D:MeshGeometryModel3D
                CullMode="Back"
                Geometry="{Binding BunnyModel}"
                Instances="{Binding BunnyInstances}"
                Material="{Binding BunnyMaterial}" />
        </controls:Viewport3DX>
        <StackPanel Grid.Column="1" Orientation="Vertical">
            <CheckBox Margin="4" IsChecked="{Binding ElementName=Viewport, Path=EnableSsao}">Enable SSAO</CheckBox>
            <Label>Radius</Label>
            <Slider
                Margin="4"
                Maximum="4"
                Minimum="0.1"
                Value="{Binding ElementName=Viewport, Path=SsaoSamplingRadius}" />
            <Label>Strength</Label>
            <Slider
                Margin="4"
                Maximum="4"
                Minimum="1"
                Value="{Binding ElementName=Viewport, Path=SsaoIntensity}" />
            <ComboBox ItemsSource="{Binding SsaoQualities}"
                      SelectedItem="{Binding ElementName=Viewport, Path=SsaoQuality}" />
        </StackPanel>
    </Grid>
</Window>
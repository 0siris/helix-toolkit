<Window
    x:Class="CrossSectionDemo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
    xmlns:local="clr-namespace:CrossSectionDemo"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:HelixToolkit.Wpf.SharpDX.Controls;assembly=SilkToolkit"
    xmlns:lights3D="clr-namespace:HelixToolkit.Wpf.SharpDX.Model.Lights3D;assembly=SilkToolkit"
    xmlns:element3D="clr-namespace:HelixToolkit.Wpf.SharpDX.Element3D;assembly=SilkToolkit"
    d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
    Title="CrossSectionDemo"
    Width="800"
    Height="600"
    mc:Ignorable="d">
    <Grid Background="Black">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto"
                              MinWidth="140" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <local:CustomViewport3DX
            x:Name="View1"
            Grid.Row="0"
            Grid.Column="0"
            Background="Black"
            BackgroundColor="Gray"
            Camera="{Binding Camera}"
            CameraRotationMode="Trackball"
            EffectsManager="{Binding EffectsManager}"
            EnableCursorPosition="True"
            FixedRotationPoint="0,0,0"
            FixedRotationPointEnabled="True"
            Msaa="Disable"
            RotateAroundMouseDownPoint="False"
            SubTitle="{Binding SubTitle}"
            TextBrush="Black"
            UseDefaultGestures="False"
            ModelAtCursor="{Binding ModelAtCursor, Mode=TwoWay}">
            <local:CustomViewport3DX.InputBindings>
                <KeyBinding Key="B" Command="controls:ViewportCommands.BackView" />
                <KeyBinding Key="F" Command="controls:ViewportCommands.FrontView" />
                <KeyBinding Key="U" Command="controls:ViewportCommands.TopView" />
                <KeyBinding Key="D" Command="controls:ViewportCommands.BottomView" />
                <KeyBinding Key="L" Command="controls:ViewportCommands.LeftView" />
                <KeyBinding Key="R" Command="controls:ViewportCommands.RightView" />
                <KeyBinding Command="controls:ViewportCommands.ZoomExtents" Gesture="Control+E" />
                <MouseBinding Command="controls:ViewportCommands.Rotate" Gesture="LeftClick" />
                <MouseBinding Command="controls:ViewportCommands.Zoom" Gesture="MiddleClick" />
            </local:CustomViewport3DX.InputBindings>
            <lights3D:DirectionalLight3D Direction="{Binding Camera.LookDirection}" Color="White" />
            <element3D:CrossSectionMeshGeometryModel3D
                x:Name="CrossModel"
                CrossSectionColor="GreenYellow"
                CullMode="Back"
                CuttingOperation="{Binding CuttingOperation}"
                EnablePlane1="{Binding EnablePlane1}"
                EnablePlane2="{Binding EnablePlane2}"
                FillMode="Solid"
                Geometry="{Binding Model}"
                IsHitTestVisible="True"
                Material="{Binding ModelMaterial}"
                Plane1="{Binding Plane1}"
                Plane2="{Binding Plane2}"
                Transform="{Binding ModelTransform}" />
            <element3D:CrossSectionMeshGeometryModel3D
                x:Name="CrossModel2"
                CrossSectionColor="GreenYellow"
                CullMode="Back"
                CuttingOperation="{Binding CuttingOperation}"
                EnablePlane1="{Binding EnablePlane1}"
                EnablePlane2="{Binding EnablePlane2}"
                FillMode="Solid"
                Geometry="{Binding BoxModel}"
                IsHitTestVisible="True"
                Material="{Binding ModelMaterial}"
                Plane1="{Binding Plane1}"
                Plane2="{Binding Plane2}" />
            <local:CrossSectionPlaneManipulator3D
                CornerScale="4"
                CutPlane="{Binding Plane1, Mode=TwoWay}"
                EdgeThicknessScale="4"
                IsRendering="{Binding EnablePlane1}"
                SizeScale="10" />
            <local:CrossSectionPlaneManipulator3D
                CornerScale="4"
                ConstrainAxis="{Binding ConstraintVector}"
                CutPlane="{Binding Plane2, Mode=TwoWay}"
                EdgeThicknessScale="4"
                IsRendering="{Binding EnablePlane2}"
                SizeScale="10" />
            <element3D:AxisPlaneGridModel3D />

        </local:CustomViewport3DX>
        <StackPanel
            Grid.Column="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Orientation="Vertical"
            TextBlock.Foreground="White">
            <CheckBox
                Margin="4"
                Foreground="White"
                IsChecked="{Binding EnablePlane1}">
                Cut Plane 1
            </CheckBox>
            <CheckBox
                Margin="4"
                Foreground="White"
                IsChecked="{Binding EnablePlane2}">
                Cut Plane 2
            </CheckBox>
            <ComboBox
                Margin="4"
                Foreground="Black"
                SelectedIndex="{Binding CuttingOperationIndex}">
                <ComboBoxItem>Intersect</ComboBoxItem>
                <ComboBoxItem>Substract</ComboBoxItem>
            </ComboBox>
            <Label Foreground="White"

                   Content="{Binding NameOfModelAtCursor}" />
        </StackPanel>
    </Grid>
</Window>
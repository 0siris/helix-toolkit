<Window
    x:Class="OrderIndependentTransparentRendering.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
    xmlns:local="clr-namespace:OrderIndependentTransparentRendering"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:HelixToolkit.Wpf.SharpDX.Controls;assembly=SilkToolkit"
    xmlns:lights3D="clr-namespace:HelixToolkit.Wpf.SharpDX.Model.Lights3D;assembly=SilkToolkit"
    xmlns:element3D="clr-namespace:HelixToolkit.Wpf.SharpDX.Element3D;assembly=SilkToolkit"
    xmlns:elements3D="clr-namespace:HelixToolkit.Wpf.SharpDX.Model.Elements3D;assembly=SilkToolkit"
    xmlns:postEffects="clr-namespace:HelixToolkit.Wpf.SharpDX.Element3D.PostEffects;assembly=SilkToolkit"
    Title="MainWindow"
    Width="1200"
    Height="800"
    mc:Ignorable="d">
    <Grid Background="Black">
        <Grid.DataContext>
            <local:MainViewModel />
        </Grid.DataContext>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <controls:Viewport3DX
            x:Name="View"
            Grid.Row="1"
            BackgroundColor="#303030"
            Camera="{Binding Camera}"
            CameraMode="Inspect"
            CameraRotationMode="Turnball"
            CoordinateSystemLabelForeground="White"
            EffectsManager="{Binding EffectsManager}"
            OitRenderMode="{Binding OitRenderType}"
            FxaaLevel="Medium" EnableD2DRendering="False"
            ShowCoordinateSystem="True">
            <controls:Viewport3DX.InputBindings>
                <KeyBinding Key="B" Command="controls:ViewportCommands.BackView" />
                <KeyBinding Key="F" Command="controls:ViewportCommands.FrontView" />
                <KeyBinding Key="U" Command="controls:ViewportCommands.TopView" />
                <KeyBinding Key="D" Command="controls:ViewportCommands.BottomView" />
                <KeyBinding Key="L" Command="controls:ViewportCommands.LeftView" />
                <KeyBinding Key="R" Command="controls:ViewportCommands.RightView" />
                <KeyBinding Command="controls:ViewportCommands.ZoomExtents" Gesture="Control+E" />
                <MouseBinding Command="controls:ViewportCommands.Rotate" Gesture="RightClick" />
                <MouseBinding Command="controls:ViewportCommands.Zoom" Gesture="MiddleClick" />
                <MouseBinding Command="controls:ViewportCommands.Pan" Gesture="LeftClick" />
            </controls:Viewport3DX.InputBindings>
            <lights3D:DirectionalLight3D Direction="{Binding Camera.LookDirection}" Color="White" />
            <element3D:LineGeometryModel3D
                Geometry="{Binding GridModel}"
                IsHitTestVisible="False"
                Thickness="0.5"
                Transform="{Binding GridTransform}"
                Color="#4F4E4E" />
            <elements3D:GroupModel3D x:Name="Group" ItemsSource="{Binding ModelGeometry}" />
            <elements3D:GroupModel3D x:Name="Plane" ItemsSource="{Binding PlaneGeometry}" />
            <postEffects:PostEffectMeshBorderHighlight
                DrawMode="{Binding DrawMode}"
                EffectName="highlight"
                NumberOfBlurPass="2" />
        </controls:Viewport3DX>
        <StackPanel
            Grid.Row="1"
            Grid.Column="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Orientation="Vertical">
            <StackPanel.CacheMode>
                <BitmapCache />
            </StackPanel.CacheMode>
            <Button Command="{Binding ResetCameraCommand}">
                Reset Camera
            </Button>
            <CheckBox Foreground="White" IsChecked="{Binding ShowWireframe}">Show Wireframe</CheckBox>
            <ComboBox ItemsSource="{Binding MaterialTypes}" SelectedItem="{Binding MaterialType}" />
            <ComboBox ItemsSource="{Binding OitRenderTypes}" SelectedItem="{Binding OitRenderType}"></ComboBox>
            <StackPanel Orientation="Vertical" IsEnabled="{Binding OitDepthPeelModeEnabled}" Margin="2, 4">
                <Label Foreground="White">Depth Peeling Iteration:</Label>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="White" Width="14"
                               Text="{Binding ElementName=View, Path=OitDepthPeelingIteration}">
                    </TextBlock>
                    <Slider Minimum="1" Maximum="16" Value="{Binding ElementName=View, Path=OitDepthPeelingIteration}"
                            Width="100" />
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Vertical" IsEnabled="{Binding OitWeightedModeEnabled}">
                <ComboBox ItemsSource="{Binding OitWeights}"
                          SelectedItem="{Binding ElementName=View, Path=OitWeightMode}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="White">OIT Weight Power:</TextBlock>
                    <TextBlock Foreground="#FFF400"
                               Text="{Binding ElementName=View, Path=OitWeightPower, StringFormat={}{0:#,0.0}}" />
                </StackPanel>
                <Slider
                    LargeChange="1"
                    Maximum="5"
                    Minimum="0.5"
                    SmallChange="0.1"
                    Value="{Binding ElementName=View, Path=OitWeightPower}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="White">OIT Weight Slope:</TextBlock>
                    <TextBlock Foreground="#FFF400"
                               Text="{Binding ElementName=View, Path=OitWeightDepthSlope, StringFormat={}{0:#,0.0}}" />
                </StackPanel>
            </StackPanel>

            <Slider
                LargeChange="1"
                Maximum="5"
                Minimum="1"
                SmallChange="0.5"
                Value="{Binding ElementName=View, Path=OitWeightDepthSlope}" />
            <CheckBox Foreground="White" IsChecked="{Binding HighlightSeparated}">HighlightSeparated</CheckBox>
            <Separator />
            <TextBlock>
                <Run Text="Red Plane Opacity: " Foreground="White" />
                <Run Text="{Binding RedPlaneOpacity}" Foreground="Yellow" />
            </TextBlock>
            <Slider Minimum="0" Maximum="100" Value="{Binding RedPlaneOpacity}" />
            <TextBlock>
                <Run Text="Green Plane Opacity: " Foreground="White" />
                <Run Text="{Binding GreenPlaneOpacity}" Foreground="Yellow" />
            </TextBlock>
            <Slider Minimum="0" Maximum="100" Value="{Binding GreenPlaneOpacity}" />
            <TextBlock>
                <Run Text="Blue Plane Opacity: " Foreground="White" />
                <Run Text="{Binding BluePlaneOpacity}" Foreground="Yellow" />
            </TextBlock>
            <Slider Minimum="0" Maximum="100" Value="{Binding BluePlaneOpacity}" />
        </StackPanel>
    </Grid>
</Window>

<Window
    x:Class="PostEffectsDemo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
    xmlns:local="clr-namespace:PostEffectsDemo"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:HelixToolkit.Wpf.SharpDX.Controls;assembly=SilkToolkit"
    xmlns:lights3D="clr-namespace:HelixToolkit.Wpf.SharpDX.Model.Lights3D;assembly=SilkToolkit"
    xmlns:element3D="clr-namespace:HelixToolkit.Wpf.SharpDX.Element3D;assembly=SilkToolkit"
    xmlns:postEffects="clr-namespace:HelixToolkit.Wpf.SharpDX.Element3D.PostEffects;assembly=SilkToolkit"
    Title="MainWindow"
    Width="800"
    Height="600"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <controls:Viewport3DX
            x:Name="View1"
            Title="{Binding Title}"
            Grid.Row="0"
            Grid.Column="0"
            Background="Black"
            BackgroundColor="Black"
            Camera="{Binding Camera}"
            CoordinateSystemLabelForeground="White"
            EffectsManager="{Binding EffectsManager}"
            EnableD2DRendering="False"
            FxaaLevel="Low"
            ModelUpDirection="0,0,1"
            ShowCoordinateSystem="False"
            SubTitle="{Binding SubTitle}"
            TextBrush="Black"
            UseDefaultGestures="False">
            <controls:Viewport3DX.InputBindings>
                <KeyBinding Key="B" Command="controls:ViewportCommands.BackView" />
                <KeyBinding Key="F" Command="controls:ViewportCommands.FrontView" />
                <KeyBinding Key="U" Command="controls:ViewportCommands.TopView" />
                <KeyBinding Key="D" Command="controls:ViewportCommands.BottomView" />
                <KeyBinding Key="L" Command="controls:ViewportCommands.LeftView" />
                <KeyBinding Key="R" Command="controls:ViewportCommands.RightView" />
                <KeyBinding Command="controls:ViewportCommands.ZoomExtents" Gesture="Control+E" />
                <MouseBinding Command="controls:ViewportCommands.Rotate" Gesture="RightClick" />
                <MouseBinding Command="controls:ViewportCommands.Zoom" Gesture="MiddleClick" />
                <MouseBinding Command="controls:ViewportCommands.Pan" Gesture="LeftClick" />
            </controls:Viewport3DX.InputBindings>
            <lights3D:DirectionalLight3D Direction="{Binding Camera.LookDirection}" Color="White" />

            <element3D:MeshGeometryModel3D
                x:Name="Mesh1"
                CullMode="Back"
                Geometry="{Binding MeshModel1}"
                Material="{Binding Material1}"
                PostEffects="xrayGrid;glow[color:#85FA00];"
                Transform="{Binding Model1Transform}" />

            <element3D:MeshGeometryModel3D
                CullMode="Back"
                Geometry="{Binding MeshModel1}"
                Material="{Binding Material3}"
                PostEffects="glow[color:#FA8000]; border[color:#004CFF]" />

            <element3D:MeshGeometryModel3D
                x:Name="Mesh2"
                CullMode="Back"
                Geometry="{Binding MeshModel2}"
                Material="{Binding Material2}"
                PostEffects="border; glow[color:#0000FF]; xrayGrid[color:#D22FDCDC]"
                Transform="{Binding Model2Transform}" />
            <element3D:MeshGeometryModel3D
                CullMode="Back"
                Geometry="{Binding MeshModel3}"
                Material="{Binding Material2}"
                PostEffects="xrayGrid"
                Transform="{Binding Model1Transform}" />
            <element3D:MeshGeometryModel3D
                CullMode="Back"
                Geometry="{Binding FloorModel}"
                Material="{Binding FloorMaterial}" />
            <element3D:LineGeometryModel3D
                Geometry="{Binding LineModel}"
                PostEffects="xrayLine"
                Color="White" />
            <element3D:ScreenSpacedGroup3D Mode="RelativeScreenSpaced">
                <element3D:MeshGeometryModel3D
                    CullMode="Back"
                    Geometry="{Binding MeshModel1}"
                    Material="{Binding Material1}"
                    PostEffects="xrayGrid;glow[color:#85FA00];"
                    Transform="{Binding Model1Transform}" />

                <element3D:MeshGeometryModel3D
                    CullMode="Back"
                    Geometry="{Binding MeshModel1}"
                    Material="{Binding Material3}"
                    PostEffects="glow[color:#FA8000]; border[color:#004CFF]" />

                <element3D:MeshGeometryModel3D
                    CullMode="Back"
                    Geometry="{Binding MeshModel2}"
                    Material="{Binding Material2}"
                    PostEffects="border; glow[color:#0000FF]; xrayGrid[color:#D22FDCDC]"
                    Transform="{Binding Model2Transform}" />
                <element3D:MeshGeometryModel3D
                    CullMode="Back"
                    Geometry="{Binding MeshModel3}"
                    Material="{Binding Material2}"
                    PostEffects="xrayGrid"
                    Transform="{Binding Model1Transform}" />
                <element3D:MeshGeometryModel3D
                    CullMode="Back"
                    Geometry="{Binding FloorModel}"
                    Material="{Binding FloorMaterial}" />
                <element3D:LineGeometryModel3D
                    Geometry="{Binding LineModel}"
                    PostEffects="xrayLine"
                    Color="White" />
            </element3D:ScreenSpacedGroup3D>
            <postEffects:PostEffectMeshXRayGrid
                x:Name="XrayGrid"
                EffectName="xrayGrid"
                GridDensity="4" />
            <postEffects:PostEffectMeshOutlineBlur
                x:Name="OutlineGlow"
                EffectName="glow"
                NumberOfBlurPass="6"
                Color="Yellow" />
            <postEffects:PostEffectMeshBorderHighlight
                x:Name="Border"
                EffectName="border"
                Color="Red" />
            <postEffects:PostEffectMeshXRay x:Name="XrayLine" EffectName="xrayLine" />
        </controls:Viewport3DX>
        <StackPanel Grid.Column="1" Orientation="Vertical">
            <CheckBox Margin="2" IsChecked="{Binding ElementName=XrayGrid, Path=IsRendering}">Mesh XRayGrid</CheckBox>
            <CheckBox Margin="2" IsChecked="{Binding ElementName=OutlineGlow, Path=IsRendering}">Glow</CheckBox>
            <CheckBox Margin="2" IsChecked="{Binding ElementName=Border, Path=IsRendering}">Mesh Outline</CheckBox>
            <CheckBox Margin="2" IsChecked="{Binding ElementName=XrayLine, Path=IsRendering}">Line XRay</CheckBox>
        </StackPanel>
    </Grid>
</Window>

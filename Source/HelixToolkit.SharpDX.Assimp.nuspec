<?xml version="1.0"?>
<package xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <metadata xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
    <id>HelixToolkit.SharpDX.Assimp</id>
    <version>$version$</version>
    <title>Assimp Import/Export for HelixToolkit.SharpDX Libraries</title>
    <authors>Lunci</authors>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/helix-toolkit/helix-toolkit</projectUrl>
    <icon>helixtoolkit.png</icon>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Provides Assimp Import/Export for the HelixToolkit DirectX libraries.</description>
    <readme>README.md</readme>
    <tags>netstandard netcore Wpf Silk.NET 3D DirectX Assimp</tags>
    <dependencies>
      <group targetFramework="net10.0-windows">
        <dependency id="HelixToolkit.Wpf.SharpDX" version="[$version$]" />
        <dependency id="AssimpNet" version="5.0.0-beta1" />
        <dependency id="Silk.NET.Direct3D11" version="2.23.0" />
        <dependency id="Silk.NET.Maths" version="2.23.0" />
      </group>
      <group targetFramework="netstandard2.0">
        <dependency id="HelixToolkit.SharpDX.Core" version="[$version$]" />
        <dependency id="AssimpNet" version="5.0.0-beta1" />
        <dependency id="Microsoft.Extensions.Logging.Abstractions" version="10.0.8"/>
        <dependency id="Silk.NET.Maths" version="2.23.0" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="HelixToolkit.Wpf.SharpDX.Assimp\bin\Release\net10.0-windows\HelixToolkit.Wpf.SharpDX.Assimp.???" target="lib\net10.0-windows" />
    <file src="HelixToolkit.SharpDX.Core.Assimp\bin\Release\netstandard2.0\HelixToolkit.SharpDX.Core.Assimp.???" target="lib\netstandard2.0" />
    <file src="HelixToolkit.SharpDX.Core.Assimp\bin\Release\netstandard2.0\HelixToolkit.SharpDX.Core.Assimp.deps.json" target="lib\netstandard2.0" />
    <file src="..\LICENSE" />
    <file src="..\AUTHORS" />
    <file src="..\CONTRIBUTORS" />
    <file src="..\README.md" />
	<file src="..\Images\helixtoolkit.png" target="" />
  </files>
</package>

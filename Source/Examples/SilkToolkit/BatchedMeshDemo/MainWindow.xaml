<Window
    x:Class="BatchedMeshDemo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
    xmlns:local="clr-namespace:BatchedMeshDemo"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:HelixToolkit.Wpf.SharpDX.Controls;assembly=SilkToolkit"
    xmlns:light3D="clr-namespace:HelixToolkit.Wpf.SharpDX.Light3D;assembly=SilkToolkit"
    xmlns:lights3D="clr-namespace:HelixToolkit.Wpf.SharpDX.Model.Lights3D;assembly=SilkToolkit"
    xmlns:element3D="clr-namespace:HelixToolkit.Wpf.SharpDX.Element3D;assembly=SilkToolkit"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Window.DataContext>
        <local:MainViewModel x:Name="ViewModel" />
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <controls:Viewport3DX
            BackgroundColor="Black"
            Camera="{Binding Camera}"
            EffectsManager="{Binding EffectsManager}"
            RotateAroundMouseDownPoint="True"
            ZoomAroundMouseDownPoint="True"
            IsShadowMappingEnabled="True"
            ShowFrameDetails="True"
            ShowViewCube="True">
            <controls:Viewport3DX.InputBindings>
                <KeyBinding Command="controls:ViewportCommands.ZoomExtents" Gesture="Control+E" />
                <MouseBinding Command="controls:ViewportCommands.Rotate" Gesture="RightClick" />
                <MouseBinding Command="controls:ViewportCommands.Zoom" Gesture="MiddleClick" />
                <MouseBinding Command="controls:ViewportCommands.Pan" Gesture="LeftClick" />
            </controls:Viewport3DX.InputBindings>
            <light3D:ShadowMap3D OrthoWidth="300" />
            <lights3D:AmbientLight3D Color="#414141" />
            <lights3D:DirectionalLight3D Direction="50, -200, -100" />
            <element3D:BatchedMeshGeometryModel3D
                x:Name="BatchedMesh"
                BatchedGeometries="{Binding BatchedMeshes}"
                BatchedMaterials="{Binding BatchedMaterials}"
                CullMode="Back"
                IsThrowingShadow="True"
                Material="{Binding MainMaterial}"
                Mouse3DDown="BatchedMeshGeometryModel3D_Mouse3DDown"
                Transform="{Binding BatchedTransform}" />
            <element3D:MeshGeometryModel3D
                CullMode="Back"
                DepthBias="-100"
                Geometry="{Binding SelectedGeometry}"
                IsHitTestVisible="False"
                IsThrowingShadow="False"
                Material="{Binding SelectedMaterial}"
                Transform="{Binding SelectedTransform}" />
            <element3D:AxisPlaneGridModel3D
                AutoSpacing="false"
                RenderShadowMap="true"
                Offset="-65" />
        </controls:Viewport3DX>
        <StackPanel Grid.Column="1" Orientation="Vertical">
            <CheckBox IsChecked="{Binding ElementName=BatchedMesh, Path=RenderWireframe}">Wireframe</CheckBox>
        </StackPanel>
    </Grid>
</Window>
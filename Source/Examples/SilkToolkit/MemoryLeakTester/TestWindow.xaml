<Window
    x:Class="MemoryLeakTester.TestWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
    xmlns:local="clr-namespace:MemoryLeakTester"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:HelixToolkit.Wpf.SharpDX.Controls;assembly=SilkToolkit"
    xmlns:lights3D="clr-namespace:HelixToolkit.Wpf.SharpDX.Model.Lights3D;assembly=SilkToolkit"
    xmlns:element3D="clr-namespace:HelixToolkit.Wpf.SharpDX.Element3D;assembly=SilkToolkit"
    Title="TestWindow"
    Width="300"
    Height="300"
    mc:Ignorable="d">
    <Grid>
        <controls:Viewport3DX x:Name="View" EffectsManager="{Binding EffectsManager}">
            <lights3D:DirectionalLight3D Direction="-1,-1,-1" Color="{Binding DirectionalLightColor}" />
            <element3D:MeshGeometryModel3D Geometry="{Binding Mesh}" Material="{Binding Material}" />
            <element3D:LineGeometryModel3D
                Geometry="{Binding LineMesh}"
                Thickness="0.2"
                Color="{Binding LineColor}" />
        </controls:Viewport3DX>
    </Grid>
</Window>
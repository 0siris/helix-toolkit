<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>HelixToolkit.SharpDX.Core</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cyotek.Drawing.BitmapFont" Version="2.0.0"/>
    <PackageReference Include="Silk.NET.Direct2D" Version="2.23.0"/>
    <PackageReference Include="Silk.NET.Direct3D.Compilers" Version="2.23.0"/>
    <PackageReference Include="Silk.NET.Direct3D11" Version="2.23.0"/>
    <PackageReference Include="Silk.NET.Direct3D12" Version="2.23.0"/>
    <PackageReference Include="Silk.NET.DXGI" Version="2.23.0"/>
    <PackageReference Include="Silk.NET.Maths" Version="2.23.0"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8"/>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp">
      <HintPath>$(NuGetPackageRoot)microsoft.csharp\4.7.0\lib\netstandard2.0\Microsoft.CSharp.dll</HintPath>
    </Reference>
    <Reference Include="System.CodeDom">
      <HintPath>$(NuGetPackageRoot)system.codedom\10.0.9\lib\net10.0\System.CodeDom.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SilkToolkit.Native.ShaderBuilder\SilkToolkit.Native.ShaderBuilder.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"/>
    <InternalsVisibleTo Include="SilkCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\*.cso"/>
    <None Remove="Resources\DX12\**\*.dxil"/>
    <EmbeddedResource Include="..\SilkToolkit\Textures\arial.dds">
      <LogicalName>SilkCore.Resources.arial.dds</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\SilkToolkit\Textures\arial.fnt">
      <LogicalName>SilkCore.Resources.arial.fnt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="PrepareGeneratedShaderResources"
          BeforeTargets="AssignTargetPaths"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_GeneratedShaderResource Include="Resources\*.cso"/>
      <_GeneratedDxilShaderResource Include="Resources\DX12\**\*.dxil"/>
      <EmbeddedResource Include="@(_GeneratedShaderResource)">
        <LogicalName>SilkCore.Resources.%(_GeneratedShaderResource.Filename)%(_GeneratedShaderResource.Extension)</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="@(_GeneratedDxilShaderResource)">
        <LogicalName>SilkCore.Resources.DX12.$([System.String]::Copy('%(_GeneratedDxilShaderResource.RecursiveDir)').Replace('\', '.'))%(_GeneratedDxilShaderResource.Filename)%(_GeneratedDxilShaderResource.Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

</Project>

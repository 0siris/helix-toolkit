<?xml version="1.0"?>
<package xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <metadata xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
    <id>HelixToolkit.SharpDX.Core</id>
    <version>$version$</version>
    <title>HelixToolkit DirectX core</title>
    <authors>Lunci</authors>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/helix-toolkit/helix-toolkit</projectUrl>
    <icon>helixtoolkit.png</icon>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Provides the DirectX rendering core based on Silk.NET.</description>
    <readme>README.md</readme>
    <tags>netstandard netcore Silk.NET 3D DirectX</tags>
    <dependencies>
      <group targetFramework="netstandard2.0">
        <dependency id="Cyotek.Drawing.BitmapFont" version="2.0.0" />
        <dependency id="HelixToolkit" version="[$version$]" />
        <dependency id="Microsoft.CSharp" version="4.7.0" />
        <dependency id="Silk.NET.Direct2D" version="2.23.0" />
        <dependency id="Silk.NET.Direct3D.Compilers" version="2.23.0" />
        <dependency id="Silk.NET.Direct3D11" version="2.23.0" />
        <dependency id="Silk.NET.DXGI" version="2.23.0" />
        <dependency id="Silk.NET.Maths" version="2.23.0" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="HelixToolkit.SharpDX.Core\bin\Release\netstandard2.0\HelixToolkit.SharpDX.Core.???" target="lib\netstandard2.0" />
    <file src="HelixToolkit.SharpDX.Core\bin\Release\netstandard2.0\HelixToolkit.SharpDX.Core.deps.json" target="lib\netstandard2.0" />
    <file src="..\LICENSE" />
    <file src="..\AUTHORS" />
    <file src="..\CONTRIBUTORS" />
    <file src="..\README.md" />
	<file src="..\Images\helixtoolkit.png" target="" />
  </files>
</package>

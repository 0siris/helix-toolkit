<Project Sdk="MSBuild.Sdk.Extras/3.0.44">

    <PropertyGroup>
        <OutputType>AppContainerExe</OutputType>

        <TargetFramework>uap10.0.18362</TargetFramework>
        <TargetPlatformMinVersion>10.0.18362.0</TargetPlatformMinVersion>

        <RootNamespace>HelixToolkit.UWP.Tests</RootNamespace>
        <AssemblyName>HelixToolkit.UWP.Tests</AssemblyName>
        <DefaultLanguage>en-US</DefaultLanguage>

        <Platforms>x86;x64;ARM</Platforms>

        <RestoreProjectStyle>PackageReference</RestoreProjectStyle>

        <DefineConstants>TRACE;NETFX_CORE;WINDOWS_UWP</DefineConstants>

        <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
        <PackageCertificateKeyFile>HelixToolkit.UWP.Tests_TemporaryKey.pfx</PackageCertificateKeyFile>
        <PackageCertificateThumbprint>B109A55BA4D3DC63B3500D554F69898F49CEFB8A</PackageCertificateThumbprint>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>full</DebugType>
        <Optimize>false</Optimize>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugType>pdbonly</DebugType>
        <Optimize>true</Optimize>
        <UseDotNetNativeToolchain>true</UseDotNetNativeToolchain>
    </PropertyGroup>

    <ItemGroup>
        <SDKReference Include="TestPlatform.Universal, Version=$(VisualStudioVersion)" />
    </ItemGroup>

    <ItemGroup>
        <AppxManifest Include="Package.appxmanifest">
            <SubType>Designer</SubType>
        </AppxManifest>
    </ItemGroup>

    <ItemGroup>
        <Content Include="Properties\UnitTestApp.rd.xml" />
        <Content Include="Assets\LockScreenLogo.scale-200.png" />
        <Content Include="Assets\SplashScreen.scale-200.png" />
        <Content Include="Assets\Square150x150Logo.scale-200.png" />
        <Content Include="Assets\Square44x44Logo.scale-200.png" />
        <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
        <Content Include="Assets\StoreLogo.png" />
        <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    </ItemGroup>

    <ItemGroup>
        <None Include="HelixToolkit.UWP.Tests_TemporaryKey.pfx" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HelixToolkit.UWP\HelixToolkit.UWP.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NETCore.UniversalWindowsPlatform" Version="6.2.14" />
        <PackageReference Include="MSTest.TestAdapter" Version="2.1.2" />
        <PackageReference Include="MSTest.TestFramework" Version="2.1.2" />
    </ItemGroup>

</Project>
<Project>
  <PropertyGroup>
    <DxcCompileAll Condition="'$(DxcCompileAll)' == ''">false</DxcCompileAll>
    <DxcPackageRoot Condition="'$(DxcPackageRoot)' == ''">$(PkgMicrosoft_Direct3D_DXC)</DxcPackageRoot>
    <DxcToolPath Condition="'$(DxcToolPath)' == '' and '$(DxcPackageRoot)' != '' and Exists('$(DxcPackageRoot)\build\native\bin\x64\dxc.exe')">$(DxcPackageRoot)\build\native\bin\x64\dxc.exe</DxcToolPath>
    <DxcDebugArgs Condition="'$(DxcDebugArgs)' == '' and '$(Configuration)' == 'Debug'">-Zi -Qembed_debug</DxcDebugArgs>
    <DxcDebugArgs Condition="'$(DxcDebugArgs)' == ''">-O3</DxcDebugArgs>
  </PropertyGroup>

  <Target Name="PrepareDxcShaders"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <DxcAdditionalInput Include="$(MSBuildProjectDirectory)\Common\*.hlsl"
                          Condition="Exists('$(MSBuildProjectDirectory)\Common')"/>
    </ItemGroup>

    <ItemGroup Condition="'$(DxcCompileAll)' == 'true'">
      <DxcShader Include="@(HLSLShader)">
        <ObjectFileOutput></ObjectFileOutput>
      </DxcShader>
    </ItemGroup>

    <ItemGroup>
      <DxcShader>
        <EntryPointName Condition="'%(DxcShader.EntryPointName)' == ''">main</EntryPointName>
        <ShaderProfile Condition="'%(DxcShader.ShaderProfile)' == 'vs_4_0' or '%(DxcShader.ShaderProfile)' == 'vs_5_0'">vs_6_0</ShaderProfile>
        <ShaderProfile Condition="'%(DxcShader.ShaderProfile)' == 'ps_4_0' or '%(DxcShader.ShaderProfile)' == 'ps_5_0'">ps_6_0</ShaderProfile>
        <ShaderProfile Condition="'%(DxcShader.ShaderProfile)' == 'gs_4_0' or '%(DxcShader.ShaderProfile)' == 'gs_5_0'">gs_6_0</ShaderProfile>
        <ShaderProfile Condition="'%(DxcShader.ShaderProfile)' == 'cs_4_0' or '%(DxcShader.ShaderProfile)' == 'cs_5_0'">cs_6_0</ShaderProfile>
        <ShaderProfile Condition="'%(DxcShader.ShaderProfile)' == 'hs_4_0' or '%(DxcShader.ShaderProfile)' == 'hs_5_0'">hs_6_0</ShaderProfile>
        <ShaderProfile Condition="'%(DxcShader.ShaderProfile)' == 'ds_4_0' or '%(DxcShader.ShaderProfile)' == 'ds_5_0'">ds_6_0</ShaderProfile>
      </DxcShader>
    </ItemGroup>

    <ItemGroup>
      <DxcShader>
        <ObjectFileOutput Condition="'%(DxcShader.ObjectFileOutput)' == ''">$(TargetDir)DX12\%(DxcShader.RelativeDir)%(Filename).%(DxcShader.EntryPointName).dxil</ObjectFileOutput>
      </DxcShader>
    </ItemGroup>
  </Target>

  <Target Name="CompileDxcShaders"
          DependsOnTargets="PrepareDxcShaders;RunDxcShaders"
          BeforeTargets="CoreCompile"
          Condition="'$(DesignTimeBuild)' != 'true'"/>

  <Target Name="RunDxcShaders"
          Inputs="@(DxcShader);@(DxcAdditionalInput)"
          Outputs="%(DxcShader.ObjectFileOutput)"
          Condition="'@(DxcShader)' != '' and '$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(DxcToolPath)' == ''"
           Text="Microsoft.Direct3D.DXC package path was not found. Add PackageReference Microsoft.Direct3D.DXC with GeneratePathProperty=true."/>
    <Error Condition="'%(DxcShader.ShaderProfile)' == ''"
           Text="DxcShader item '%(DxcShader.Identity)' requires ShaderProfile metadata."/>

    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('%(DxcShader.ObjectFileOutput)'))"/>

    <Message Importance="High"
             Text="DXC %(DxcShader.Identity) -> %(DxcShader.ObjectFileOutput)"/>
    <Exec Command="&quot;$(DxcToolPath)&quot; -nologo -E &quot;%(DxcShader.EntryPointName)&quot; -T &quot;%(DxcShader.ShaderProfile)&quot; -HV 2021 -I &quot;$(MSBuildProjectDirectory)&quot; -Fo &quot;%(DxcShader.ObjectFileOutput)&quot; $(DxcDebugArgs) &quot;%(DxcShader.FullPath)&quot;"/>
  </Target>
</Project>

@startuml Helix Toolkit Repository Structure
title Helix Toolkit - Active Solutions, Project Mappings & Defines

skinparam backgroundColor #FFFFFF
skinparam nodeBackgroundColor #E3F2FD
skinparam nodeBorderColor #1565C0
skinparam packageBackgroundColor #E8EAF6
skinparam packageBorderColor #3F51B5
skinparam arrowColor #1565C0
skinparam arrowThickness 2

skinparam noteBackgroundColor #FFF9C4
skinparam noteBorderColor #F57F17
skinparam noteFontSize 12

legend right
  .csproj : C# Project\n  Target: .NET 10 (WPF) | netstandard2.0 (Core)
  .shproj : Shared Project (linked files)
  [Demo] : Example/Demo Project
  [Test] : Test Project
end legend

'' =====================================================================
' Solution 1: HelixToolkit.Wpf.sln
' =====================================================================
package "HelixToolkit.Wpf.sln" as sln_wpf {
    component [HelixToolkit.Wpf.csproj\n(netcoreapp3.1 / .NET 4.6.2)] as wpf_engine
    component [HelixToolkit.Wpf.Input.csproj\n(.NET 4.6.2)] as wpf_input
    component [HelixToolkit.Wpf.Tests.csproj\n(.NET 4.6.2)] as wpf_tests
    component [WPF Demos\n(~25 Examples)] as wpf_demos
}

wpf_engine -down-> wpf_input
wpf_engine -left-> wpf_tests
wpf_engine -up-> wpf_demos

note bottom of wpf_tests : Tests: TRACE
note bottom of wpf_input : Defines: TRACE

'' =====================================================================
' Solution 2: HelixToolkit.Core.Wpf.sln
' =====================================================================
package "HelixToolkit.Core.Wpf.sln" as sln_corewpf {
    component [HelixToolkit.Core.Wpf.csproj\n(netcoreapp3.1)] as corewpf
    component [CoreWpfDemo.csproj\n(.NET Core 3.1)] as corewpf_demo
}

corewpf -down-> corewpf_demo

note bottom of corewpf : Shared from Wpf/Shared

'' =====================================================================
' Solution 3: HelixToolkit.SharpDX.sln
' =====================================================================
package "HelixToolkit.SharpDX.sln" as sln_sharpdx {
    component [HelixToolkit.SharpDX.Core.csproj\n(netstandard2.0)] as sharpdx_core
    component [HelixToolkit.Wpf.SharpDX.csproj\n(net10.0-windows)] as wpf_sharpdx
    component [HelixToolkit.Wpf.SharpDX.Tests.csproj\n(net10.0-windows)] as wpf_sharpdx_tests
    component [HelixToolkit.SharpDX.Core.Assimp.csproj\n(netstandard2.0)] as sharpdx_core_assimp
    component [HelixToolkit.Wpf.SharpDX.Assimp.csproj\n(net10.0-windows)] as wpf_sharpdx_assimp
    component [WPF.SharpDX Demos\n(active Examples)] as sharpdx_demos
    component [SharpDX.Core Demos\n(4 active Examples)] as sharpdx_core_demos
}

sharpdx_core --> wpf_sharpdx
sharpdx_core --> sharpdx_core_assimp
sharpdx_core --> sharpdx_core_demos
wpf_sharpdx --> wpf_sharpdx_tests
wpf_sharpdx --> wpf_sharpdx_assimp
wpf_sharpdx --> sharpdx_demos

note bottom of sharpdx_core : Defines:\nNETFX_CORE | CORE | SHARPDX | DX11 | MSAA | DX11_1
note bottom of wpf_sharpdx : Defines:\nDX11 | MSAA | SHARPDX
note bottom of wpf_sharpdx_assimp : Defines:\nSHARPDX
note bottom of sharpdx_core_assimp : Defines:\nNETFX_CORE | CORE

'' =====================================================================
' Solution 4: HelixToolkit.SharpDX.Core.sln
' =====================================================================
package "HelixToolkit.SharpDX.Core.sln" as sln_sharpdx_core {
    component [HelixToolkit.SharpDX.Core.csproj\n(netstandard2.0)] as sharpdx_core2
    component [HelixToolkit.SharpDX.Core.Wpf.csproj\n(legacy)] as sharpdx_core_wpf2
    component [HelixToolkit.SharpDX.Core.Assimp.csproj\n(netstandard2.0)] as sharpdx_core_assimp2
    component [HelixToolkit.SharpDX.Core.Tests.csproj\n(netstandard2.0)] as sharpdx_core_tests
    component [HelixToolkit.csproj\n(netstandard2.0)] as core_lib
    component [HelixToolkit.SharpDX.Assimp.Shared.shproj] as shared_assimp
    component [SharpDX.Core Demos\n(some Examples)] as sharpdx_demos2
}

sharpdx_core2 --> sharpdx_core_wpf2
sharpdx_core2 --> sharpdx_core_assimp2
sharpdx_core2 --> sharpdx_core_tests
sharpdx_core2 --> core_lib
sharpdx_core2 --> sharpdx_demos2

note right of core_lib : Core library\n(no non-default defines)
note bottom of sharpdx_core_wpf2 : Legacy; not part of the\nsupported WPF DirectX gate.

'' =====================================================================
' Solution 5: HelixToolkit.WinUI.sln
' =====================================================================
package "HelixToolkit.WinUI.sln" as sln_winui {
    component [HelixToolkit.WinUI.csproj\n(net6.0-windows)] as winui2
    component [HelixToolkit.SharpDX.Core.csproj\n(netstandard2.0)] as sharpdx_core3
    component [HelixToolkit.csproj\n(netstandard2.0)] as core_lib2
    component [HelixToolkit.SharpDX.Core.Assimp.csproj\n(netstandard2.0)] as sharpdx_core_assimp3
    component [HelixToolkit.Native.ShaderBuilder.csproj] as shader_builder
    component [ModelViewer.csproj\n(WinUI Demo)] as model_viewer
}

winui2 --> sharpdx_core3
winui2 --> sharpdx_core_assimp3
winui2 --> shader_builder
winui2 --> model_viewer

note bottom of sln_winui : Legacy only. WinUI is not supported,\nnot built in active CI and not packaged.

'' =====================================================================
' Solution 6: HelixToolkit.Kinect.sln
' =====================================================================
package "HelixToolkit.Kinect.sln" as sln_kinect {
    component [HelixToolkit.Wpf.csproj\n(.NET 4.6.2)] as wpf_engine2
    component [HelixToolkit.csproj\n(netstandard2.0)] as core_lib3
    component [DepthSensorDemo.csproj\n(WPF Kinect)] as depth_sensor
}

wpf_engine2 --> core_lib3
wpf_engine2 --> depth_sensor

'' =====================================================================
' Solution 7: HelixToolkit.AppVeyor.sln
' =====================================================================
package "HelixToolkit.AppVeyor.sln" as sln_appveyor {
    component [CI Build\n(All Major Projects)] as ci_all
    note left of ci_all : Historical broad CI map.\nThe active product gate is\nHelixToolkit.SharpDX.sln.\nWinUI and UWP are legacy.
}

'' =====================================================================
' Shared Projects (cross-cutting)
' =====================================================================
package "Shared Project Files" as shared_proj {
    component [HelixToolkit.Shared.shproj] as shared_core_proj
    component [HelixToolkit.Wpf.Shared.shproj] as shared_wpf_proj
    component [HelixToolkit.SharpDX.Shared.shproj] as shared_sharpdx_proj
    component [HelixToolkit.SharpDX.SharedModel.shproj] as shared_models_proj
    component [HelixToolkit.UWP.Shared.shproj] as shared_uwp_proj
    component [HelixToolkit.SharpDX.Assimp.Shared.shproj] as shared_assimp_proj
}

'' =====================================================================
' Cross-solution dependencies
' =====================================================================

' Core library dependencies on shared
shared_core_proj -down-> core_lib
shared_core_proj -down-> sharpdx_core
shared_core_proj -down-> shared_sharpdx_proj

' WPF Engine dependencies
shared_core_proj -right-> wpf_engine
shared_wpf_proj -right-> wpf_engine
shared_core_proj -right-> wpf_engine2

' CoreWpf references shared
shared_core_proj -down-> corewpf
shared_wpf_proj -down-> corewpf

' Legacy WinUI dependencies
shared_models_proj -down-> winui2
shared_core_proj -up-> winui2
shared_sharpdx_proj -up-> winui2
shared_assimp_proj -up-> sharpdx_core_assimp
shared_models_proj -up-> sharpdx_core_assimp

' =====================================================================
' Notes - Target Framework Summary
' =====================================================================

